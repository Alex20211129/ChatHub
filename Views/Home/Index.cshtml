@{
    ViewData["Title"] = "首頁";
}

<div class="hero-section text-center">
    <h1 class="display-5 fw-bold">ChatRoomSys</h1>
    <p class="lead mb-4">練習作品集：同時用原生 WebSocket 與 SignalR 打造同一個聊天室功能，並沿用 MemberShipSys.Core 的會員系統。</p>
    <a asp-controller="Chat" asp-action="Index" class="btn btn-light btn-lg">
        <i class="bi bi-chat-dots-fill"></i> 進入聊天室
    </a>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="feature-icon"><i class="bi bi-lightning-charge-fill"></i></div>
                <h5 class="card-title">原生 WebSocket</h5>
                <p class="card-text text-muted">手刻連線管理、廣播、在線名單，理解即時通訊的底層機制。</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="feature-icon"><i class="bi bi-broadcast"></i></div>
                <h5 class="card-title">SignalR</h5>
                <p class="card-text text-muted">高階封裝、自動重連、事件分派，開發效率更高的即時通訊方案。</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="feature-icon"><i class="bi bi-shield-lock-fill"></i></div>
                <h5 class="card-title">會員系統</h5>
                <p class="card-text text-muted">沿用 MemberShipSys.Core，訪客可用暱稱聊天，會員登入後享有歷史訊息。</p>
            </div>
        </div>
    </div>
</div>
